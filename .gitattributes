# Ensure shell scripts always use LF line endings (needed for Docker on Windows)
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Cryptographic cross-runtime fixtures must remain byte-for-byte stable on Windows.
packages/quukk-clawmessenger/src/protocol/fixtures/discussion-wire-cross-runtime.json text eol=lf

# Runtime provenance is generated and verified byte-for-byte on every platform.
packages/quukk-clawmessenger-runtime-*/SOURCE.md text eol=lf

# Vendored legal text must preserve upstream whitespace byte-for-byte.
GO_THIRD_PARTY_NOTICES.md text eol=lf whitespace=-blank-at-eol
packages/quukk-clawmessenger-runtime-*/GO_THIRD_PARTY_NOTICES.md text eol=lf whitespace=-blank-at-eol

# Default behavior
* text=auto
